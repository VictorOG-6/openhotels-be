# ============================
# Application Settings
# ============================
APP_NAME=Open Hotel API
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ============================
# Database (required)
# ============================
# Local example:
# DATABASE_URL=postgresql://user:password@localhost:5432/open_hotel
# Railway provides DATABASE_URL automatically when you attach Postgres.

DATABASE_URL=

# ============================
# Security & Authentication
# ============================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=

# ============================
# Admin User Settings
# ============================
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Nuitee
NUITE_API_URL=
NUITEE_BOOK_API_URL=
NUITEE_PRIVATE_KEY=
NUITEE_PUBLIC_KEY=
NUITEE_PAYMENT_SDK_KEY=
